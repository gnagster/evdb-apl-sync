{
  "name": "evdb-apl-sync",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-22",
  "assets": { "directory": "./dashboard", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "routes": [{ "pattern": "ev.dinne.beer/*", "zone_name": "dinne.beer" }],
  "workers_dev": false,
  "preview_urls": false,
  "secrets": { "required": ["DEEPSEEK_API_KEY"] },
  "ratelimits": [{ "name": "AI_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "observability": { "enabled": false }
}
